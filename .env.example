# Copy into Vercel → Project → Settings → Environment Variables (Production + Preview).

# Public site URL for SEO (sitemap, Open Graph, canonical URLs) — use your live domain in production
# NEXT_PUBLIC_SITE_URL=https://www.stylesnest.store

# Meta (Facebook) Pixel — optional override (default ID is set in MetaPixel.tsx)
# NEXT_PUBLIC_META_PIXEL_ID=1513218677132314

# Required: Neon Postgres — use the POOLED connection string from Neon dashboard
# (host contains -pooler, e.g. ep-xxx-pooler.region.aws.neon.tech). Avoid unpooled URL for serverless.
DATABASE_URL=

# Cloudinary — use CLOUDINARY_URL OR the three vars below
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional: prefix for uploads (folder organization)
# CLOUDINARY_UPLOAD_PREFIX=

# Optional: emergency admin password reset token (keep secret)
# ADMIN_RESET_TOKEN=

# Optional: only for one-off migrate-database tooling (not needed for normal runtime)
# OLD_DATABASE_URL=

# --- Customer login (NextAuth) — required for orders ---
# Generate secret (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=FanMEWqhpHpcMjeeJw5jHafEm+62aHR+eYJb+plzJc0=
AUTH_URL=http://localhost:3000

# Google OAuth (optional — button shows only when both are set)
AUTH_GOOGLE_ID=218335006916-gc8654q0aa0hs7dvq91lf06h10tb6c61.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=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

# Apple Sign In (optional)
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# Optional: extra salt for email passwords (defaults built-in if empty)
# SHOP_AUTH_SALT=
